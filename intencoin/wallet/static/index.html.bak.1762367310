<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>INTEN Wallet</title>
<style>
  :root{
    --bg:#001f3f; --fg:#ffffff; --muted:#a8b3c7; --card:#0a2a55; --line:#1f3a66; --btn:#1e90ff; --btn2:#0db37f;
  }
  *{box-sizing:border-box}
  body{margin:0; background:var(--bg); color:var(--fg); font-family:system-ui, Arial, sans-serif}
  .wrap{max-width:960px; margin:0 auto; padding:24px}
  h1{margin:6px 0 18px 0}
  h2{margin:18px 0 10px 0}
  h3{margin:16px 0 8px 0}
  .grid{display:grid; gap:16px}
  .col2{grid-template-columns:repeat(2,minmax(0,1fr))}
  .card{background:var(--card); border:1px solid var(--line); border-radius:12px; padding:16px}
  label{display:block; font-size:13px; color:var(--muted); margin:6px 0 4px}
  input{width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:10px; background:#062247; color:var(--fg)}
  button{padding:10px 14px; border-radius:10px; border:1px solid var(--line); background:var(--btn); color:#fff; cursor:pointer}
  button.alt{background:var(--btn2)}
  button:disabled{opacity:.6; cursor:not-allowed}
  pre{white-space:pre-wrap; background:#061a34; border:1px solid var(--line); border-radius:10px; padding:10px; color:#def}
  .row{display:flex; gap:8px; flex-wrap:wrap; align-items:center}
  .hidden{display:none}
  .hr{height:1px; background:var(--line); margin:16px 0}
  .pill{display:inline-block; padding:6px 10px; border:1px solid var(--line); border-radius:999px; color:#cfe3ff; font-size:12px}
</style>
</head>
<body>
  <div class="wrap">
    <h1>INTEN Wallet</h1>
    <div class="pill">UI ↔ Node on same origin</div>

    <!-- AUTH CARDS -->
    <div class="grid col2">
      <div class="card">
        <h2>Register</h2>
        <label for="r_name">Name</label>
        <input id="r_name" placeholder="Your name" />
        <label for="r_email">Email</label>
        <input id="r_email" placeholder="you@example.com" />
        <label for="r_pass">Password</label>
        <input id="r_pass" type="password" placeholder="••••••••" />
        <div class="row" style="margin-top:8px">
          <button id="btn_register" onclick="register()">Register</button>
        </div>
        <div class="hr"></div>
        <pre id="r_out"></pre>
      </div>

      <div class="card">
        <h2>Login</h2>
        <label for="l_email">Email</label>
        <input id="l_email" placeholder="you@example.com" />
        <label for="l_pass">Password</label>
        <input id="l_pass" type="password" placeholder="••••••••" />
        <div class="row" style="margin-top:8px">
          <button id="btn_login" onclick="login()">Login</button>
        </div>
        <div class="hr"></div>
        <pre id="l_out"></pre>
      </div>
    </div>

    <!-- DASHBOARD (ONLY WHEN LOGGED) -->
    <div class="card hidden" data-dashboard>
      <div class="row" style="justify-content:space-between">
        <h2 style="margin:0">Dashboard</h2>
        <button onclick="logout()">Logout</button>
      </div>

      <div class="grid col2">
        <div>
          <h3>Balance</h3>
          <div class="row">
            <button onclick="balance()">Check Balance</button>
          </div>
          <pre id="bal"></pre>

          <div class="hr"></div>

          <h3>Create Wallet</h3>
          <div class="row">
            <button onclick="createWallet()">Create Wallet</button>
          </div>
          <pre id="addr"></pre>
        </div>

        <div>
          <h3>Transfer (Email → Email)</h3>
          <label for="to_email">Recipient email</label>
          <input id="to_email" placeholder="dest@example.com" />
          <label for="amt">Amount (INTEN)</label>
          <input id="amt" type="number" step="0.000001" placeholder="0" />
          <div class="row" style="margin-top:6px">
            <button onclick="transfer()">Send</button>
          </div>

          <div class="hr"></div>

          <h3>Withdraw (to external address)</h3>
          <label for="ext">External address</label>
          <input id="ext" placeholder="external wallet address" />
          <label for="wamt">Amount (INTEN)</label>
          <input id="wamt" type="number" step="0.000001" placeholder="0" />
          <div class="row" style="margin-top:6px">
            <button class="alt" onclick="withdraw()">Withdraw</button>
          </div>
        </div>
      </div>

      <div class="hr"></div>

      <h3>Transactions</h3>
      <div class="row">
        <button onclick="tx()">Refresh</button>
      </div>
      <pre id="txs"></pre>

      <div class="hr"></div>

      <h3>Convert (auto-amount)</h3>
      <div class="row">
        <button onclick="convertTo('USD')">USD</button>
        <button onclick="convertTo('EUR')">EUR</button>
        <button onclick="convertTo('BTC')">BTC</button>
        <button onclick="convertTo('ETH')">ETH</button>
        <button onclick="convertTo('DOGE')">DOGE</button>
        <button onclick="convertTo('XLM')">XLM</button>
        <button onclick="convertTo('AMR')">AMR</button>
      </div>
      <pre id="a_out"></pre>
    </div>
  </div>

<script>
/* === INTEN Wallet Frontend Glue === */
const $ = (id)=>document.getElementById(id);

// Persist token
let TOKEN = localStorage.getItem('INTEN_TOKEN') || null;

// Dashboard visibility
function showDashboard(auth) {
  const dash = document.querySelector('[data-dashboard]');
  if (!dash) return;
  dash.classList.toggle('hidden', !auth);
}

// Generic API helper (adds Authorization automatically)
async function api(path, method='GET', body=null) {
  const h = {'Content-Type':'application/json'};
  if (TOKEN) h['Authorization'] = 'Bearer ' + TOKEN;
  const r = await fetch(path, {method, headers:h, body: body ? JSON.stringify(body) : null});
  const txt = await r.text();
  let json = {};
  try { json = JSON.parse(txt); } catch { json = {error:'non-json', status:r.status, text:txt}; }
  if (!r.ok) throw json;
  return json;
}

// Register
async function register(){
  try{
    const btn = document.getElementById('btn_register'); btn.disabled = true;
    const out = await api('/auth/register','POST',{
      name: $('#r_name').value,
      email: $('#r_email').value,
      password: $('#r_pass').value
    });
    $('#r_out').innerText = JSON.stringify(out,null,2);
    if (out.token) {
      TOKEN = out.token;
      localStorage.setItem('INTEN_TOKEN', TOKEN);
      showDashboard(true);
      await balance();
    }
  }catch(err){
    $('#r_out').innerText = JSON.stringify(err,null,2);
  }finally{
    document.getElementById('btn_register').disabled = false;
  }
}

// Login
async function login(){
  try{
    const btn = document.getElementById('btn_login'); btn.disabled = true;
    const out = await api('/auth/login','POST',{
      email: $('#l_email').value,
      password: $('#l_pass').value
    });
    $('#l_out').innerText = JSON.stringify(out,null,2);
    if (out.token) {
      TOKEN = out.token;
      localStorage.setItem('INTEN_TOKEN', TOKEN);
      showDashboard(true);
      await balance();
    }
  }catch(err){
    $('#l_out').innerText = JSON.stringify(err,null,2);
  }finally{
    document.getElementById('btn_login').disabled = false;
  }
}

// Logout (button inside dashboard only)
function logout(){
  TOKEN = null;
  localStorage.removeItem('INTEN_TOKEN');
  showDashboard(false);
  $('#bal').innerText = '';
  $('#addr').innerText = '';
  $('#a_out').innerText = '';
  $('#txs').innerText = '';
}

// Balance
async function balance(){
  try{
    const out = await api('/api/balance','GET');
    $('#bal').innerText = JSON.stringify(out,null,2);
  }catch(err){ $('#bal').innerText = JSON.stringify(err,null,2); }
}

// Create Wallet/Address
async function createWallet(){
  try{
    const out = await api('/api/wallet/create','POST',{});
    $('#addr').innerText = JSON.stringify(out,null,2);
    await balance();
  }catch(err){ $('#addr').innerText = JSON.stringify(err,null,2); }
}

// Transfer by email
async function transfer(){
  try{
    const toEmail = $('#to_email').value.trim();
    const amount = parseFloat($('#amt').value||'0');
    const out = await api('/api/transfer','POST',{ toEmail, amount });
    $('#a_out').innerText = JSON.stringify(out,null,2);
    await balance();
  }catch(err){ $('#a_out').innerText = JSON.stringify(err,null,2); }
}

// Withdraw to external address (Python)
async function withdraw(){
  try{
    const external_address = $('#ext').value.trim();
    const amount = parseFloat($('#wamt').value||'0');
    const out = await api('/api/withdraw-request','POST',{ external_address, amount });
    $('#a_out').innerText = JSON.stringify(out,null,2);
    await balance();
  }catch(err){ $('#a_out').innerText = JSON.stringify(err,null,2); }
}

// Transactions
async function tx(){
  try{
    const out = await api('/api/transactions','GET');
    $('#txs').innerText = JSON.stringify(out,null,2);
  }catch(err){ $('#txs').innerText = JSON.stringify(err,null,2); }
}

// Convert (auto-amount)
async function convertTo(sym){
  try{
    const out = await api('/api/convert','POST',{ to: sym });
    $('#a_out').innerText = JSON.stringify(out,null,2);
  }catch(err){ $('#a_out').innerText = JSON.stringify(err,null,2); }
}

// Init on load
document.addEventListener('DOMContentLoaded', ()=>{
  showDashboard(!!TOKEN);
});
</script>
</body>
</html>
