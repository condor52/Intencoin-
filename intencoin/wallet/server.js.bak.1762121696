/* ====== Static + index ====== */
app.use(express.static(path.join(__dirname, 'static')));
app.get('/', (req,res)=> res.sendFile(path.join(__dirname, 'static', 'index.html')));

/* ====== Listen ====== */
app.listen(PORT, ()=> console.log('INTEN Wallet listening on', PORT));

// === GET /api/transactions (token) ===
app.get('/api/transactions', auth, (req, res) => {
  try {
    let txs = [];
    try { if (fs.existsSync(TXS)) txs = JSON.parse(fs.readFileSync(TXS, 'utf8') || '[]'); } catch {}
    const uid  = req.user.uid;
    const addr = req.user.address;

    const items = txs.filter(t =>
      t.user_id === uid ||
      t.from_user === uid || t.to_user === uid ||
      t.from_address === addr || t.to_address === addr
    );

    return res.json({ ok: true, items });
  } catch (e) {
    console.error('/api/transactions error:', e);
    return res.status(500).json({ error: 'server' });
  }
});

// === POST /api/convert (token) ===
// Convierte TODO tu balance INTEN a la moneda destino (USD, EUR, BTC, ETH, DOGE, XLM, AMR)
const INTEN_RATES = { USD:1.25, EUR:1.10, BTC:0.00002, ETH:0.0003, DOGE:2.0, XLM:10, AMR:1.0 };

app.post('/api/convert', auth, (req, res) => {
  try {
    const to = ((req.body && req.body.to) || '').toString().trim().toUpperCase();
    if (!to || !INTEN_RATES[to]) {
      return res.status(400).json({ error: 'unsupported', detail: `to=${to}` });
    }
    // Lee balance real del usuario desde USERS
    const users = JSON.parse(fs.readFileSync(USERS, 'utf8') || '{}');
    const u = users[req.user.uid] || {};
    const bal = Number(u.balance || 0);
    const rate = INTEN_RATES[to];
    const amount_converted = +(bal * rate).toFixed(8);

    return res.json({ ok: true, from: 'INTEN', to, balance: bal, rate, amount_converted });
  } catch (e) {
    console.error('/api/convert error:', e);
    return res.status(500).json({ error: 'server' });
  }
});
